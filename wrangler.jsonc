{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cooking-app",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // 入口は workers.dev の 1 つだけ。バージョンごとのプレビュー URL は無効にする（docs/deploy.md）
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    // 画面は SPA。認証を画面にもかけるため、すべてのリクエストを先に Worker に通す
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    // Cloudflare Access の設定（docs/deploy.md の手順 3）。空にすると全リクエストを拒否する
    "ACCESS_TEAM_DOMAIN": "gentle-moon-9112.cloudflareaccess.com",
    "ACCESS_AUD": "f4834e60b903606d53e47b43db601d0f8732ce35d1c6791e39bc46876da74a2e"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cooking-app",
      // 本番 D1 の ID（ローカル開発では使われない）
      "database_id": "d7632761-7199-4360-85b7-d7db88fa139a",
      "migrations_dir": "migrations"
    }
  ],
  // AI（Cursor SDK）を動かす Container（docs/design/08-agent.md）
  "containers": [
    {
      "class_name": "AgentContainer",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "AGENT", "class_name": "AgentContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentContainer"] }],
  // vite dev では Container を作らない（.dev.vars で AI_PROVIDER=fake にする）。本物で試すときは wrangler dev
  "dev": { "enable_containers": false },
  "observability": { "enabled": true }
}
